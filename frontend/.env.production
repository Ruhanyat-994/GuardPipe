# Loaded automatically by `vite build` (production mode) — not by `npm run dev`,
# which uses .env.local instead (see .env.example).
#
# Relative, not absolute: the EKS deployment (DEPLOYMENT.md) puts guardpipe-web
# and guardpipe-api behind the same ALB hostname (/ -> web, /api/* -> api), so
# the browser's own same-origin requests just need a path, never a hostname —
# this also sidesteps the ALB's hostname not being known until after the first
# apply (deploy/k8s/07-ingress.yaml).
VITE_API_BASE_URL=/api/v1
