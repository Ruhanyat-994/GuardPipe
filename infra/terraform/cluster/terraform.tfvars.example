# Copy to terraform.tfvars (gitignored) and fill in real values.
state_bucket          = "guardpipe-tfstate-XXXXXXXX" # from bootstrap/'s state_bucket_name output
state_dynamodb_table  = "guardpipe-tfstate-lock"     # from bootstrap/'s state_lock_table_name output
state_region          = "ap-northeast-1"             # must match bootstrap/'s aws_region
budget_alert_email    = "you@example.com"
