# Copy to .env and fill in real values. Never commit .env itself.
# Full reference: documentation/13-devops-and-environments.md §5

# --- Compose-only: Postgres container credentials ---
POSTGRES_USER=guardpipe
POSTGRES_PASSWORD=guardpipe
POSTGRES_DB=guardpipe

# --- Compose-only: bind-mount host paths for postgres/redis data ---
# Defaults below are repo-local and gitignored, so the stack persists data
# across `docker compose down`/`up` with zero setup. Override with an
# absolute path (e.g. a dedicated data drive) if you want the data living
# somewhere else on disk instead of inside the repo folder.
# GUARDPIPE_POSTGRES_DATA_DIR=./.docker-data/postgres
# GUARDPIPE_REDIS_DATA_DIR=./.docker-data/redis

# --- Core ---
GUARDPIPE_ENV=development
GUARDPIPE_ROLE=all
GUARDPIPE_HTTP_PORT=8080
GUARDPIPE_LOG_LEVEL=info
GUARDPIPE_BASE_URL=http://localhost:8080

# --- Data (required) ---
GUARDPIPE_DATABASE_URL=postgres://guardpipe:guardpipe@postgres:5432/guardpipe?sslmode=disable
GUARDPIPE_DB_MAX_CONNS=25
GUARDPIPE_REDIS_URL=redis://redis:6379/0
GUARDPIPE_MIGRATE_ON_START=true

# --- Security (required — generate with: openssl rand -base64 48) ---
GUARDPIPE_JWT_SECRET=replace-with-32-bytes-minimum-random-secret
GUARDPIPE_ENCRYPTION_KEY=replace-with-base64-of-exactly-32-bytes
GUARDPIPE_ACCESS_TOKEN_TTL=15m
# Session idle timeout — Refresh resets this forward on every rotation, so
# an actively-used session never hits it; an abandoned one dies this long
# after the last request (BUILD_GUIDE.md Phase 14).
GUARDPIPE_REFRESH_TOKEN_TTL=30m
# Session absolute timeout — dies this long after the original login
# regardless of activity, on top of the idle timeout above (BUILD_GUIDE.md
# Phase 14).
GUARDPIPE_SESSION_ABSOLUTE_TTL=12h
GUARDPIPE_CORS_ORIGINS=http://localhost:5173
# /auth/register and /auth/login share this one bucket per client IP
# (documentation/07-api-specification.md §1.6 specifies 5/min — the default
# below matches, so a default deployment stays spec-compliant). On a local
# dev machine everything (browser + curl/test scripts) shares one IP, so
# normal testing can exhaust 5/min fast; raise these in your own .env if
# that's biting you locally — don't change the shipped default here.
GUARDPIPE_AUTH_RATE_LIMIT=5
GUARDPIPE_AUTH_RATE_WINDOW=1m
# Defaults to true when GUARDPIPE_ENV=production, false otherwise — set this
# explicitly to override. Only turn this off in production for a deployment
# that's genuinely not behind TLS yet (browsers silently refuse to store a
# Secure-flagged cookie set over plain HTTP, which breaks session persistence
# across a page reload); turn it back on the moment real HTTPS is in front of
# the app.
# GUARDPIPE_SECURE_COOKIES=false

# --- Scanning ---
GUARDPIPE_WORKER_COUNT=4
GUARDPIPE_WORKSPACE_ROOT=/var/lib/guardpipe/workspace
GUARDPIPE_MAX_REPO_MB=500
GUARDPIPE_SANDBOX_MAX=2
# Built locally via `docker compose build pentest-sandbox`
# (internal/scripts/pentest/Dockerfile) — never pushed to any registry, so
# this is a plain tag, not a pinned digest like most other image references
# in this file. Leave empty to run without pentest tool execution (the
# engine still registers and fails its jobs cleanly instead).
GUARDPIPE_SANDBOX_IMAGE=guardpipe-pentest-sandbox:latest
GUARDPIPE_DOCKER_HOST=unix:///var/run/docker.sock
GUARDPIPE_DOCKER_NETWORK=guardpipe-net
# Named Docker volume backing GUARDPIPE_WORKSPACE_ROOT — see docker-compose.yml's
# volumes.workspace.name. codescan's sonar-scanner sibling container mounts
# this volume by name (with a subpath) to read the cloned checkout, since
# GUARDPIPE_WORKSPACE_ROOT is only a valid path inside guardpipe's own container.
GUARDPIPE_WORKSPACE_VOLUME=guardpipe-workspace
# containerscan's Trivy sibling container (Phase 8, ADR-0012) — no token/API URL
# needed, unlike SonarQube; Trivy is a local CLI invocation, not a service.
# Leave GUARDPIPE_TRIVY_IMAGE unset to use the pinned default in adapters/trivy.
# GUARDPIPE_TRIVY_IMAGE=aquasec/trivy:0.56.2
GUARDPIPE_TRIVY_DB_UPDATE=true
# Named Docker volume the Trivy sibling container mounts (by name, same
# shape as GUARDPIPE_WORKSPACE_VOLUME) to persist its vulnerability database
# across scans instead of re-downloading it every run — see
# docker-compose.yml's volumes.trivy_cache.name.
GUARDPIPE_TRIVY_CACHE_VOLUME=guardpipe-trivy-cache

# --- Pentest ---
GUARDPIPE_PENTEST_ENABLED=true
GUARDPIPE_ALLOW_PRIVATE_TARGETS=false
GUARDPIPE_PENTEST_DENYLIST=
GUARDPIPE_PENTEST_RATE_LIMIT=10
GUARDPIPE_PENTEST_PORTS=top100

# --- AI ---
GUARDPIPE_AI_ENABLED=true
GUARDPIPE_GEMINI_API_KEY=replace-with-your-gemini-api-key
# GUARDPIPE_GEMINI_API_KEYS=key-from-project-1,key-from-project-2  # optional rotation pool (comma-separated), prefer this over the singular key once you have more than one — see BUILD_GUIDE.md Phase 4 on why keys should come from separate Google Cloud projects
GUARDPIPE_GEMINI_MODEL_FAST=gemini-2.5-flash
# gemini-2.5-pro (the "smart" tier's original default) 404s as
# NOT_FOUND on a free-tier API key — confirmed live, BUILD_GUIDE.md
# Phase 13's AI-enrichment work (generate_patch, which requests the
# smart tier) failed 100% of its calls against it. Pointed at flash too,
# matching CLAUDE.md's "zero budget (Gemini free tier)" constraint — if
# your key does have pro access, feel free to point this back.
GUARDPIPE_GEMINI_MODEL_SMART=gemini-2.5-flash
GUARDPIPE_AI_TOKEN_BUDGET_PER_SCAN=100000
GUARDPIPE_AI_CACHE_TTL=168h

# --- External ---
GUARDPIPE_OSV_API_URL=https://api.osv.dev
GUARDPIPE_OSV_CACHE_TTL=24h
GUARDPIPE_GITHUB_API_URL=https://api.github.com

# codescan (Phase 7, ADR-0011) — self-hosted SonarQube CE, the `sonarqube` Compose service, not SonarCloud
GUARDPIPE_SONARQUBE_API_URL=http://sonarqube:9000
GUARDPIPE_SONARQUBE_TOKEN=replace-with-a-user-token-generated-in-sonarqube-s-own-ui-on-first-boot
GUARDPIPE_SONARQUBE_ANALYSIS_TIMEOUT=5m

# SonarQube's own dedicated Postgres DB (docker-compose.yml's sonarqube-db service) — not GuardPipe's app database
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=local-dev-only-changeme
SONARQUBE_DB_NAME=sonarqube

# --- Gate thresholds ---
GUARDPIPE_GATE_WARN=30
GUARDPIPE_GATE_BLOCK=70
